ENV=development
# Set these two and Makefile derives PORT/APP_PORT/POSTGRES_PORT/DB_PORT from them.
APP_LISTEN_PORT=8080
DB_LISTEN_PORT=5432

DB_NAME=mycoorigyn_marketing
DB_HOST=localhost
DB_USER=mycoorigyn
DB_PASSWORD=mycoorigyn
DB_SSLMODE=disable

PUBLIC_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
READ_TIMEOUT_SECONDS=10
WRITE_TIMEOUT_SECONDS=10
IDLE_TIMEOUT_SECONDS=60
SHUTDOWN_TIMEOUT_SECONDS=10

# Closed-alpha approval and signup grant configuration. Local development keeps
# delivery disabled unless a fake/test sender is injected by tests.
MARKETING_EMAIL_PROVIDER=disabled
MARKETING_EMAIL_FROM=MycoOrigyn <notifications@example.com>
MARKETING_EMAIL_REPLY_TO=
MARKETING_RESEND_API_KEY_FILE=/run/secrets/marketing-resend-api-key
MARKETING_EARLY_ACCESS_REVIEW_RECIPIENT=reviewer@example.com
MARKETING_PUBLIC_WEB_ORIGIN=http://localhost:5173
MARKETING_REVIEW_BASE_URL=http://localhost:5173/early-access/review
MYCOORIGYN_HOSTED_SIGNUP_BASE_URL=http://localhost:5173/signup
MARKETING_TOKEN_SECRET_ROOT=.local/marketing-tokens
MARKETING_PROVISIONING_SHARED_SECRET_FILE=/run/secrets/marketing-provisioning-shared-secret
MARKETING_REVIEW_TOKEN_TTL_SECONDS=604800
MARKETING_SIGNUP_GRANT_TTL_SECONDS=604800
MARKETING_SIGNUP_GRANT_CLAIM_TTL_SECONDS=1800

# Optional override. When unset, the app builds the DSN from DB_* values and
# uses POSTGRES_PORT as the DB port default for local development.
# DATABASE_URL=postgres://mycoorigyn:mycoorigyn@localhost:5432/mycoorigyn_marketing?sslmode=disable
