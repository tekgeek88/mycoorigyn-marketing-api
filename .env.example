ENV=development
# Set these two and Makefile derives PORT/APP_PORT/POSTGRES_PORT/DB_PORT from them.
APP_LISTEN_PORT=8080
DB_LISTEN_PORT=5432

DB_NAME=mycoorigyn_marketing
DB_HOST=localhost
DB_USER=mycoorigyn
DB_PASSWORD=mycoorigyn
DB_SSLMODE=disable

PUBLIC_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
READ_TIMEOUT_SECONDS=10
WRITE_TIMEOUT_SECONDS=10
IDLE_TIMEOUT_SECONDS=60
SHUTDOWN_TIMEOUT_SECONDS=10

# Optional override. When unset, the app builds the DSN from DB_* values and
# uses POSTGRES_PORT as the DB port default for local development.
# DATABASE_URL=postgres://mycoorigyn:mycoorigyn@localhost:5432/mycoorigyn_marketing?sslmode=disable
